# --- Core ---
ENVIRONMENT=development            # development | production
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=100
FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=900

# --- Production hardening ---
# REQUIRED in production: comma-separated allowlist of frontend origins.
# The app refuses to boot in production if this is empty (fail-closed).
#   CORS_ORIGINS_RAW=https://pdfstudio.app,https://www.pdfstudio.app
CORS_ORIGINS_RAW=

# Per-IP sliding-window rate limit. Off in dev (so tests aren't throttled);
# turn ON in production.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=30

# Optional error tracking. When set, errors report to Sentry (PII scrubbed).
SENTRY_DSN=
