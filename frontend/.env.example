NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AdSense (all optional - leave unset to ship zero ad code).
# Client id enables the loader + /ads.txt; each slot id enables one placement.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_HUB=1234567890

# Email capture + contact form destination.
# Paste the Google Apps Script Web App URL here (see
# docs/EMAIL_SUBSCRIPTION_SETUP.md). Without it, the subscribe form returns an
# error instead of falsely confirming. Server-only - never exposed to the browser.
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Optional shared secret. Set the SAME value as a Script Property named
# SHARED_TOKEN in the Apps Script to reject requests that don't carry it.
# LEADS_WEBHOOK_TOKEN=some-long-random-string
